{
  "name": "vesrio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "文屿 Vesrio — a human-led, agent-assisted Markdown writing desktop app",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:desktop": "tauri build --debug --no-bundle --config src-tauri/tauri.e2e.conf.json && node scripts/desktop-e2e.mjs",
    "test:coverage": "vitest run --coverage",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "check:golden": "node scripts/check-golden.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "checksums": "node scripts/checksums.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@lezer/common": "^1.2.3",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "diff": "^8.0.2",
    "katex": "^0.19.0",
    "lucide-vue-next": "^0.545.0",
    "mermaid": "^11.17.2",
    "pinia": "^3.0.3",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "@types/diff": "^8.0.0",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
