{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vesrio",
  "version": "0.1.0",
  "identifier": "com.vesrio.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "文屿 · Vesrio",
        "width": 1360,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Human-led, agent-assisted Markdown writing",
    "longDescription": "Vesrio (文屿) is a local-first Markdown writing app where the author stays in control: inline AI suggestions are reviewed before they touch the document, every accepted change is undoable, and staged patches never apply to stale text.",
    "copyright": "Copyright © 2026 Vesrio",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
